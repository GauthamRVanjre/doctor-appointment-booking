# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Murf Falcon TTS. Server-side only; fill locally, never in chat.
MURF_API_KEY=

# Server-only HTTPS origin for an explicitly authorized tools-only gateway.
BOOKING_TOOLS_BASE_URL=

# Server-only Supabase transaction-pooler URI. Never paste into chat.
DATABASE_URL=

# Server-only stable signing secret, at least 32 random characters.
BOOKING_APPROVAL_SECRET=

# Exact deployed HTTPS origin, without trailing slash. Omit for localhost.
BOOKING_APP_ORIGIN=

# Deployed agent startup is disabled unless explicitly true.
# Shared limits: 10 starts/hour, 2 active sessions, no channel replay.
BOOKING_PUBLIC_DEMO=false
